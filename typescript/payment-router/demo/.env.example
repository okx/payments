# ===== OKX SA API（MPP + x402 共用） =====
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 可选：覆盖 SA API base URL（mpp）；默认 https://web3.okx.com
# SA_BASE_URL=https://web3.okx.com

# 可选：覆盖 x402 facilitator base URL；默认 https://web3.okx.com
# X402_FACILITATOR_URL=https://web3.okx.com

# ===== mppx HMAC（卖家签 402 challenge） =====
# 任意高熵字符串；不要泄露给客户端。
MPPX_SECRET_KEY=

# ===== 卖家签名（mpp session 在 settle / close 阶段签 EIP-712 授权用）=====
# 卖家私钥；生产环境请用 KMS / HSM / viem WalletClient。
SELLER_PRIVATE_KEY=

# ===== 收款地址（mpp + x402 共用） =====
# X Layer (chainId=196) 上的卖家收款地址。
# 字段名与 mpp-typescript demo 保持一致：SELLER_ADDRESS（兼容 PAY_TO_ADDRESS）
SELLER_ADDRESS=

# ===== 可选 Port =====
# SERVER_PORT=4000

# ===========================================================================
# 以下 env 由 Typescript物料 双协议 demo (dual.ts) 使用。
# 命名对齐 Rust 物料；与 MPPX_SECRET_KEY 是同一份值的不同别名。
# ===========================================================================
MPP_SECRET_KEY=
