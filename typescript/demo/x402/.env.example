# ── OKX facilitator credentials (required) ──────────────────────────────
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Optional: override default facilitator endpoint
# OKX_BASE_URL=https://web3.okx.com

# ── Subscription demo (`pnpm seller`) ───────────────────────────────────
# Merchant receiving address (required). Set this to the on-chain address
# that should receive subscription payments.
MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: merchant signing key. Only needed if you want to invoke
# merchant-initiated cancel from the admin UI; subscribe / charge / change /
# cancel-by-buyer all work without it.
# If both MERCHANT_ADDRESS and MERCHANT_PRIVATE_KEY are set they must match.
# MERCHANT_PRIVATE_KEY=0x

# Optional overrides:
# CHAIN_NETWORK=eip155:196     # CAIP-2; default X Layer mainnet. Testnet = eip155:1952
# TOKEN_ADDRESS=0x…            # default = SDK's per-network stablecoin (USDT0 on X Layer)
# TOKEN_DECIMALS=6             # default from per-network stablecoin info
# SELLER_PORT=4242             # admin UI port

# ── Non-subscription demo (`pnpm start`) ────────────────────────────────
# Seller receiving address (only used by src/index.ts exact-scheme demo)
SELLER_ADDRESS=0x0000000000000000000000000000000000000000
# Server port for the exact-scheme demo
PORT=3000
