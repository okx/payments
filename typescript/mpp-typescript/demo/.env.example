# ===== OKX SA API（正式网） =====
# https://web3.okx.com 上申请的 API Key / Secret / Passphrase。
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 可选：覆盖 SA API base URL；默认 https://web3.okx.com（与 SDK 默认一致）
# SA_BASE_URL=https://web3.okx.com

# ===== mppx HMAC（卖家签 402 challenge） =====
# 任意高熵字符串；不要泄露给客户端。
MPPX_SECRET_KEY=

# ===== 卖家签名（settle / close 用 EIP-712 授权） =====
# 卖家私钥；生产用 KMS / HSM 或 viem WalletClient。
SELLER_PRIVATE_KEY=
# 卖家收款地址。EIP-3009 的 to + Voucher 验签的 payee。
SELLER_ADDRESS=

# ===== 买家签名（demo 端真实签 EIP-3009 / Voucher） =====
# 买家私钥；从私钥派生 BUYER_ADDRESS，无需单独配置。
# 必须在 X Layer 上对应的 token 有余额，否则 SA API 会拒绝。
BUYER_PRIVATE_KEY=

# ===== Token / 链配置 =====
# X Layer chainId = 196。CHARGE_CONFIG.currency 也用这条链上的 token。
# CHAIN_ID=196
# X Layer 上 token 合约（USDC / USDT）。默认值与 server.ts CHARGE_CONFIG.currency 对齐。
# TOKEN_ADDRESS=0x779ded0c9e1022225f8e0630b35a9b54be713736
# Token 合约 EIP-712 domain。各 token 不同：
#   - Circle USDC: name="USD Coin", version="2"
#   - Tether USDT: name="USD₮0", version="1"（X Layer 上 USDT 的 EIP-3009 domain 视具体合约而定）
# 不一致 SA API 会签名验证失败。
# TOKEN_NAME=USDC
# TOKEN_VERSION=1

# ===== Escrow 合约（session 用） =====
# 默认值与 SDK Session.DEFAULT_ESCROW_CONTRACT 一致。
# ESCROW_CONTRACT=0x5E550002e64FaF79B41D89fE8439eEb1be66CE3b
# ESCROW_DOMAIN_NAME=EVM Payment Channel
# ESCROW_DOMAIN_VERSION=1

# ===== Ports（可选） =====
# SERVER_PORT=3000
# BUYER_PORT=3002

# ===========================================================================
# 以下 env 变量由 Typescript物料 demo 使用（charge.ts / charge-split.ts /
# session.ts）。命名对齐 Rust 物料；与 MPPX_SECRET_KEY / SELLER_PRIVATE_KEY
# 是同一份值的不同别名，互不冲突，按需各填一份即可。
# ===========================================================================

# Typescript物料 charge.ts / charge-split.ts / session.ts 使用：
# 与 MPPX_SECRET_KEY 同一份值（mppx HMAC，签 402 challenge）。
MPP_SECRET_KEY=

# Typescript物料 session.ts 使用：
# 与 SELLER_PRIVATE_KEY 同一份值（卖家签 EIP-712 用）。
MPP_MERCHANT_PRIVATE_KEY=
# X Layer 上 mpp session 的 escrow 合约地址；默认值见上方 ESCROW_CONTRACT。
MPP_ESCROW=0x5E550002e64FaF79B41D89fE8439eEb1be66CE3b
