{
  "name": "@okxweb3/app-payment-router",
  "version": "0.1.0",
  "description": "Unified payment router for MPP and x402 protocols (Web Standards, framework-agnostic)",
  "license": "Apache-2.0",
  "author": "okfe",
  "type": "module",
  "keywords": [
    "okx",
    "payment",
    "mpp",
    "x402",
    "402",
    "web-standards",
    "middleware"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@okxweb3/app-mpp": ">=0.1.0",
    "@okxweb3/app-x402-core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@okxweb3/app-mpp": {
      "optional": true
    },
    "@okxweb3/app-x402-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
